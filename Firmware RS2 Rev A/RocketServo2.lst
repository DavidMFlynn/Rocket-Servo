00091 0000 	; MCLR/VPP pin function is digital input
00092 0000 	; Program memory code protection is disabled
00093 0000 	; Data memory code protection is disabled
00094 0000 	; Brown-out Reset enabled
00095 0000 	; CLKOUT function is disabled. I/O or oscillator function on the CLKOUT pin
00096 0000 	; Internal/External Switchover mode is disabled
00097 0000 	; Fail-Safe Clock Monitor is enabled
00098 0000 	;
00099 8008 DFFF 		__CONFIG _CONFIG2,_WRT_OFF & _PLLEN_ON & _LVP_OFF
00100 0000 	;
00101 0000 	; Write protection off
00102 0000 	; 4x PLL Enabled
00103 0000 	; Stack Overflow or Underflow will cause a Reset
00104 0000 	; Brown-out Reset Voltage (Vbor), low trip point selected.
00105 0000 	; Low-voltage programming disabled
