00002 0000 	;
00003 0000 	;   Filename:	RocketServo2.asm
00004 0000 	;   Date:	10/19/2026
00005 0000 	;   File Version:	1.0b3
00006 0000 	;
00007 0000 	;    Author:	David M. Flynn
00008 0000 	;    E-Mail:	dflynn.oxfordvue@gmail.com
00009 0000 	;
00010 0000 	;====================================================================================================
00011 0000 	;    RC Servo Activator (2 channel) for high power rocketry uses PIC16F1847
00012 0000 	;
00013 0000 	;    History:
00014 0000 	; 1.0b3   10/19/2026   Battery voltage...
00015 0000 	; 1.0b2   10/12/2026   Power up glitch?
00016 0000 	; 1.0b1   12/20/2025   Copied from RocketServo rev 1.2b1
00017 0000 	;
00018 0000 	;====================================================================================================
00019 0000 	; Options
00020 0000 	;
00021 0000 0000 	BP3Hold	EQU	0	;Hold at position 2 value
00022 0000 0000 	ReverseS1	EQU	0	;1 = reversed for Stager
00023 0000 	;
00024 0000 	;====================================================================================================
00025 0000 	; To Do's
00026 0000 	;
00027 0000 	;====================================================================================================
00028 0000 	;====================================================================================================
00029 0000 	; What happens next:
00030 0000 	;
00031 0000 	;   The system LED blinks once per second
00032 0000 	;  Once at power-up:
00033 0000 	;   Blink battery voltage i.e. _ ......... _
00034 0000 	;   Do not arm if <7.0 2S LiPO, fast blink for 10 seconds
00035 0000 	;   Wiggle each servo ±50uS from command position while looking at the current.
00036 0000 	;     Blink servo LED if servo found.
00037 0000 	;     Set enables for altimeter inputs.
00038 0000 	;   Set position to the commanded position for 3 seconds.
00039 0000 	;
00040 0000 	;  Setup mode:
00041 0000 	;   Activate the servo before setting timing.
00042 0000 	;   If SW1 is pressed Increment the set value for the control condition.
00043 0000 	;   If SW2 is pressed Decrement the set value for the control condition.
00044 0000 	;
00045 0000 	;   If Control is High (active)
00046 0000 	;      move to set point 1 for 3 seconds
00047 0000 	;   else if Control is Low (Normal, Inactive)
00048 0000 	;      move to set point 2 for 3 seconds
00049 0000 	;
00050 0000 	;   CCP1, CCP2 outputs a 900uS to 2100uS (1800..4200 counts) pulse every 16,000uS
00051 0000 	;
00052 0000 	;   Resolution is 0.5uS
00053 0000 	;
00054 0000 	;  if kInPosShutdown is set servo will power down after 3s
00055 0000 	;
00056 0000 	;====================================================================================================
00057 0000 	;
00058 0000 	;  Pin 1  RA2 		SW1 Inc switch Active Low Input 
00059 0000 	;  Pin 2  RA3 		Enable1 Conductivity Enable Active Low Output	
00060 0000 	;  Pin 3  RA4 		Enable2 Conductivity Enable Active Low Output		
00061 0000 	;  Pin 4  RA5/MCLR*/Vpp (Input only)	Vpp	
00062 0000 	;  Pin 5  VSS (Ground)		Ground
00063 0000 	;  Pin 6  RB0/CCP1		Servo1 Signal Output
00064 0000 	;  Pin 7  RB1		Trigger1 Active Low Input
00065 0000 	;  Pin 8  RB2		Trigger2 Active Low Input
00066 0000 	;  Pin 9  RB3		Servo2LED Active Active Low Output
00067 0000 	;  Pin 10 RB4		Servo1LED Active Active Low Output
00068 0000 	;  Pin 11 RB5		SW2 Dec switch Active Low Input
00069 0000 	;  Pin 12 RB6 ICSPCLK		PGC
00070 0000 	;  Pin 13 RB7 ICSPDAT		PGD
00071 0000 	;  Pin 14 VDD (+5V)		+5V
00072 0000 	;  Pin 15 RA6 		System LED Active Low Output
00073 0000 	;  Pin 16 RA7/CCP2		Servo2 Signal Output
00074 0000 	;  Pin 17 RA0 AN0/Battery (volts-0.5)/21
00075 0000 	;  Pin 18 RA1 AN1/Servo_I
00076 0000 	;
00077 0000 	;====================================================================================================
00078 0000 	;
00079 0000 	;
00080 0000 		list	p=16f1847,r=hex,w=1	; list directive to define processor
00081 0000 	;
00001 0000 		nolist
00002 0000 	;
00003 0000 	;==========================================================================
00004 0000 	;  MPASM PIC16F1847 processor include
00005 0000 	; 
00006 0000 	;  (c) Copyright 1999-2013 Microchip Technology, All rights reserved
00007 0000 	;  Modified by DMF 11/16/2013
00008 0000 	;==========================================================================
00009 0000 	;
01163 0000 		NOLIST
01164 0000 	;
00084 0000 		list
00085 0000 	;
00086 8007 EFA4 		__CONFIG _CONFIG1,_FOSC_INTOSC & _WDTE_OFF & _MCLRE_OFF & _IESO_OFF
00087 0000 	;
00088 0000 	;
00089 0000 	; INTOSC oscillator: I/O function on CLKIN pin
00090 0000 	; WDT disabled
